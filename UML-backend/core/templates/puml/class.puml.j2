@startuml
{% set title_parts = project_name ~ ('-' ~ module_name if module_name else '') %}
title {{ title_parts }}-类图
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 50

{%- for cls in classes %}
{%- set cls_name = cls.name if cls is mapping else cls %}
{%- set cls_key = cls_name if cls_name in class_details else "" %}
class "{{ cls_name }}" {
{%- if cls_key and class_details is defined and cls_key in class_details %}
  ' 属性区 (默认设为 private: -)
  {%- for attr in class_details[cls_key].get("attributes", []) %}
  - {{ attr }};
  {%- endfor %}
  ' 方法区 (默认设为 public: +)
  {%- for method in class_details[cls_key].get("methods", []) %}
  + {{ method }}{% if not method.endswith('()') %}(){% endif %};
  {%- endfor %}
{%- endif %}
}
{%- endfor %}

' 2.1 Association (关联关系: --)
{%- for rel in class_relationships.get("association", []) %}
"{{ rel[0] }}" -- "{{ rel[1] }}"
{%- endfor %}
{%- for rel in class_relationships.get("generalization", []) %}
"{{ rel[0] }}" --|> "{{ rel[1] }}"
{%- endfor %}
{%- for rel in class_relationships.get("composition", []) %}
"{{ rel[0] }}" *-- "{{ rel[1] }}"
{%- endfor %}
{%- for rel in class_relationships.get("aggregation", []) %}
"{{ rel[0] }}" o-- "{{ rel[1] }}"
{%- endfor %}
{%- for rel in class_relationships.get("dependency", []) %}
"{{ rel[0] }}" ..> "{{ rel[1] }}"
{%- endfor %}
@enduml
